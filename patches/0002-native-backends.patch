diff --git a/vlib/v/gen/amd64/native_scalar.v b/vlib/v/gen/amd64/native_scalar.v
new file mode 100644
index 00000000..e6d4514a
--- /dev/null
+++ b/vlib/v/gen/amd64/native_scalar.v
@@ -0,0 +1,138 @@
+module amd64
+
+import v.gen.nativeopt
+import v.ssa
+
+fn (mut g Gen) gen_native_scalar(id ssa.ValueID, instr ssa.Instruction) bool {
+	if instr.op == .br && instr.operands.len == 3 {
+		then_block := int(instr.operands[1])
+		else_block := int(instr.operands[2])
+		if nativeopt.has_phi(g.m, then_block) || nativeopt.has_phi(g.m, else_block) {
+			return false
+		}
+		mut cond := cc_ne
+		if cmp := g.selection.inputs[id] {
+			g.load_val_to_reg(int(rax), cmp.operands[0])
+			g.load_val_to_reg(int(rcx), cmp.operands[1])
+			asm_cmp_rax_rcx(mut g)
+			cond = amd64_scalar_condition(cmp.op)
+		} else if reg := g.reg_map[instr.operands[0]] {
+			asm_test_reg_reg(mut g, Reg(reg))
+		} else {
+			g.load_val_to_reg(int(rax), instr.operands[0])
+			asm_test_rax_rax(mut g)
+		}
+		if then_block == g.next_block {
+			g.emit_scalar_jump(cond ^ 1, else_block)
+		} else {
+			g.emit_scalar_jump(cond, then_block)
+			if else_block != g.next_block {
+				g.emit_jmp(else_block)
+			}
+		}
+		return true
+	}
+	if address := nativeopt.array_address(g.m, instr) {
+		if off := g.stack_map[address.array] {
+			g.load_val_to_reg(int(rax), address.index)
+			asm_load_reg_rbp_disp(mut g, rcx, off + address.size_offset)
+			asm_imul_rax_rcx(mut g)
+			asm_load_reg_rbp_disp(mut g, rcx, off + address.data_offset)
+			asm_add_rax_rcx(mut g)
+			g.store_reg_to_val(int(rax), id)
+			return true
+		}
+	}
+	if instr.operands.len != 2 || instr.op !in [.get_element_ptr, .udiv, .shl, .lshr, .ashr] {
+		return false
+	}
+	if scaled := g.selection.inputs[id] {
+		g.load_val_to_reg(int(rax), instr.operands[0])
+		g.load_val_to_reg(int(rcx), scaled.operands[0])
+		shift := nativeopt.shift_constant(g.m, scaled.operands[1], 3)
+		// lea rax, [rax + rcx * (1 << shift)]
+		g.emit(0x48)
+		g.emit(0x8d)
+		g.emit(0x04)
+		g.emit(u8(shift << 6) | 0x08)
+		g.store_reg_to_val(int(rax), id)
+		return true
+	}
+	rhs := g.m.values[instr.operands[1]]
+	if rhs.kind != .constant || rhs.name == 'undef' || nativeopt.int_width(g.m, rhs.typ) == 0 {
+		return false
+	}
+	imm := g.integer_constant_value(rhs)
+	if instr.op in [.shl, .lshr, .ashr] && imm >= 0 && imm < 64
+		&& nativeopt.int_width(g.m, g.m.values[instr.operands[0]].typ) == 64
+		&& nativeopt.int_width(g.m, instr.typ) == 64 {
+		g.load_val_to_reg(int(rax), instr.operands[0])
+		if imm != 0 {
+			g.emit(0x48)
+			g.emit(0xc1)
+			g.emit(match instr.op {
+				.shl { u8(0xe0) }
+				.lshr { u8(0xe8) }
+				else { u8(0xf8) }
+			})
+			g.emit(u8(imm))
+		}
+		g.store_reg_to_val(int(rax), id)
+		return true
+	}
+	if instr.op == .get_element_ptr && imm >= min_i32 && imm <= max_i32 {
+		g.load_val_to_reg(int(rax), instr.operands[0])
+		if imm != 0 {
+			g.emit(0x48)
+			g.emit(0x8d)
+			if imm >= -128 && imm <= 127 {
+				g.emit(0x40)
+				g.emit(u8(imm))
+			} else {
+				g.emit(0x80)
+				g.emit_u32(u32(imm))
+			}
+		}
+		g.store_reg_to_val(int(rax), id)
+		return true
+	}
+	if instr.op == .udiv && nativeopt.int_width(g.m, instr.typ) == 64 {
+		magic := nativeopt.division_magic(u64(imm)) or { return false }
+		g.load_val_to_reg(int(rax), instr.operands[0])
+		asm_mov_reg_imm64(mut g, rcx, magic.multiplier)
+		// mul rcx writes the full product to rdx:rax.
+		g.emit(0x48)
+		g.emit(0xf7)
+		g.emit(0xe1)
+		// shr rdx, imm8
+		g.emit(0x48)
+		g.emit(0xc1)
+		g.emit(0xea)
+		g.emit(u8(magic.shift))
+		g.store_reg_to_val(int(rdx), id)
+		return true
+	}
+	return false
+}
+
+fn (mut g Gen) emit_scalar_jump(cc u8, target ssa.BlockID) {
+	g.emit(0x0f)
+	g.emit(0x80 | (cc & 0x0f))
+	g.emit_jump_displacement(target)
+}
+
+fn amd64_scalar_condition(op ssa.OpCode) u8 {
+	return match op {
+		.eq { cc_e }
+		.ne { cc_ne }
+		.lt { cc_l }
+		.gt { cc_g }
+		.le { cc_le }
+		.ge { cc_ge }
+		.ult { cc_b }
+		.ugt { cc_a }
+		.ule { cc_be }
+		.uge { cc_ae }
+		else { cc_ne }
+	}
+}
diff --git a/vlib/v/gen/amd64/regalloc.v b/vlib/v/gen/amd64/regalloc.v
new file mode 100644
index 00000000..cb6a71bc
--- /dev/null
+++ b/vlib/v/gen/amd64/regalloc.v
@@ -0,0 +1,184 @@
+module amd64
+
+import v.ssa
+
+struct LiveInterval {
+	id ssa.ValueID
+mut:
+	start      int
+	end        int
+	definition int
+	weight     int
+	use_blocks []int
+}
+
+// allocate_live_registers gives each value one home for its entire live interval.
+// Whole-interval spills preserve the emitter's existing fixed scratch registers
+// and avoid inserting transfers at calls. Every allocatable register survives calls.
+fn (mut g Gen) allocate_live_registers(func ssa.Function) {
+	if func.blocks.len > 1024 {
+		g.allocate_scalar_registers(func)
+		return
+	}
+	mut block_index := map[ssa.BlockID]int{}
+	mut block_start := []int{len: func.blocks.len}
+	mut block_end := []int{len: func.blocks.len}
+	mut preds := [][]int{len: func.blocks.len}
+	mut loop_deltas := []int{len: func.blocks.len + 1}
+	mut positions := 0
+	for bi, block in func.blocks {
+		block_index[block] = bi
+		block_start[bi] = positions
+		positions += g.m.blocks[block].instrs.len + 1
+		block_end[bi] = positions - 1
+	}
+	mut intervals := map[ssa.ValueID]LiveInterval{}
+	for param in func.params {
+		if _ := g.register_candidate_score(param, 1) {
+			intervals[param] = LiveInterval{ id: param, start: -1, end: -1, definition: 0 }
+		}
+	}
+	for bi, block in func.blocks {
+		for at, id in g.m.blocks[block].instrs {
+			val := g.m.values[id]
+			if val.kind != .instruction || id in g.selection.skipped {
+				continue
+			}
+			instr := g.m.instrs[val.index]
+			if instr.op == .inline_asm || instr.op == .phi {
+				// Raw phis and inline assembly can impose unmodeled constraints.
+				return
+			}
+			if instr.op == .assign && g.m.values[instr.operands[0]].kind == .phi_result {
+				dest := instr.operands[0]
+				if dest !in intervals {
+					if _ := g.register_candidate_score(dest, 1) {
+						// Lowered phis have edge definitions. Reserve their home throughout
+						// the function so backedges and cyclic copies cannot overlap it.
+						intervals[dest] = LiveInterval{ id: dest, start: -1, end: positions, definition: -1 }
+					}
+				}
+			}
+			if _ := g.register_candidate_score(id, 1) {
+				pos := block_start[bi] + at
+				intervals[id] = LiveInterval{ id: id, start: pos, end: pos, definition: bi }
+			}
+			for oi, operand in instr.operands {
+				if instr.is_successor_operand(oi) {
+					if successor := block_index[operand] {
+						preds[successor] << bi
+						if successor <= bi {
+							loop_deltas[successor]++
+							loop_deltas[bi + 1]--
+						}
+					}
+				}
+			}
+		}
+	}
+	mut depth := 0
+	for bi, block in func.blocks {
+		depth += loop_deltas[bi]
+		weight := 1 + depth * 4
+		for at, id in g.m.blocks[block].instrs {
+			val := g.m.values[id]
+			if val.kind != .instruction || id in g.selection.skipped {
+				continue
+			}
+			pos := block_start[bi] + at
+			add_live_uses(mut intervals, g.m.instrs[val.index], bi, pos, weight)
+			if producer := g.selection.inputs[id] {
+				add_live_uses(mut intervals, producer, bi, pos, weight)
+			}
+		}
+	}
+	mut live := []LiveInterval{cap: intervals.len}
+	mut seen := []int{len: func.blocks.len}
+	mut pending := []int{}
+	mut stamp := 0
+	for _, interval in intervals {
+		if interval.weight == 0 {
+			continue
+		}
+		mut iv := interval
+		if iv.use_blocks.len > 0 {
+			stamp++
+			pending << iv.use_blocks
+			for pending.len > 0 {
+				block := pending.pop()
+				if seen[block] == stamp {
+					continue
+				}
+				seen[block] = stamp
+				if block == iv.definition {
+					// The value is live from its definition to every outgoing edge.
+					if block_end[block] > iv.end {
+						iv.end = block_end[block]
+					}
+					continue
+				}
+				if block_start[block] < iv.start {
+					iv.start = block_start[block]
+				}
+				if block_end[block] > iv.end {
+					iv.end = block_end[block]
+				}
+				pending << preds[block]
+			}
+		}
+		live << iv
+	}
+	live.sort(a.start < b.start)
+	g.scan_live_intervals(live)
+}
+
+fn add_live_uses(mut intervals map[ssa.ValueID]LiveInterval, instr ssa.Instruction, block int, pos int, weight int) {
+	for i, operand in instr.operands {
+		if !instr.is_value_operand(i) || (instr.op == .assign && i == 0) {
+			continue
+		}
+		if interval := intervals[operand] {
+			mut iv := interval
+			if iv.end < pos {
+				iv.end = pos
+			}
+			iv.weight += weight
+			if iv.definition >= 0 && iv.definition != block
+				&& (iv.use_blocks.len == 0 || iv.use_blocks.last() != block) {
+				iv.use_blocks << block
+			}
+			intervals[operand] = iv
+		}
+	}
+}
+
+fn (mut g Gen) scan_live_intervals(intervals []LiveInterval) {
+	regs := [int(rbx), int(r12), int(r13), int(r14), int(r15)]!
+	mut active := [5]LiveInterval{}
+	for iv in intervals {
+		mut victim := 0
+		for slot, resident in active {
+			if resident.id == 0 || resident.end < iv.start {
+				victim = slot
+				break
+			}
+			if resident.weight < active[victim].weight
+				|| (resident.weight == active[victim].weight && resident.end > active[victim].end) {
+				victim = slot
+			}
+		}
+		old := active[victim]
+		if old.id != 0 && old.end >= iv.start {
+			if old.weight > iv.weight || (old.weight == iv.weight && old.end <= iv.end) {
+				continue
+			}
+			g.reg_map.delete(old.id)
+		}
+		reg := regs[victim]
+		g.reg_map[iv.id] = reg
+		if reg !in g.used_regs {
+			g.used_regs << reg
+		}
+		active[victim] = iv
+	}
+}
