diff --git a/vlib/v/gen/nativeopt/nativeopt.v b/vlib/v/gen/nativeopt/nativeopt.v
new file mode 100644
index 00000000..41533fa7
--- /dev/null
+++ b/vlib/v/gen/nativeopt/nativeopt.v
@@ -0,0 +1,161 @@
+module nativeopt
+
+import v.ssa
+
+// Selection records adjacent, single-use producers folded into consumers.
+pub struct Selection {
+pub mut:
+	inputs  map[ssa.ValueID]ssa.Instruction
+	skipped map[ssa.ValueID]bool
+}
+
+// select_local finds integer compare/branch, scaled GEP, and optional multiply/add pairs.
+pub fn (mut result Selection) select_local(m &ssa.Module, func ssa.Function, mul_add bool) {
+	result.inputs.clear()
+	result.skipped.clear()
+	mut uses := map[ssa.ValueID]int{}
+	for block in func.blocks {
+		for id in m.blocks[block].instrs {
+			value := m.values[id]
+			if value.kind != .instruction {
+				continue
+			}
+			instr := m.instrs[value.index]
+			for i, operand in instr.operands {
+				if instr.is_value_operand(i) && m.values[operand].kind == .instruction {
+					uses[operand]++
+				}
+			}
+		}
+	}
+	for block in func.blocks {
+		ids := m.blocks[block].instrs
+		for i in 1 .. ids.len {
+			producer := m.values[ids[i - 1]]
+			consumer := m.values[ids[i]]
+			if producer.kind != .instruction || consumer.kind != .instruction
+				|| uses[producer.id] != 1 || producer.id in result.inputs {
+				continue
+			}
+			input := m.instrs[producer.index]
+			output := m.instrs[consumer.index]
+			if input.operands.len != 2 || output.operands.len < 2 {
+				continue
+			}
+			compare := output.op == .br && output.operands.len == 3 && output.operands[0] == producer.id
+				&& is_int_compare(m, input) && !has_phi(m, output.operands[1])
+				&& !has_phi(m, output.operands[2])
+			address := output.op == .get_element_ptr && output.operands[1] == producer.id
+				&& input.op == .shl && int_width(m, input.typ) == 64
+				&& int_width(m, m.values[input.operands[0]].typ) == 64
+				&& shift_constant(m, input.operands[1], 3) != 0
+			multiply := mul_add && output.op == .add && producer.id in output.operands
+				&& input.op == .mul && int_width(m, input.typ) == 64 && output.typ == input.typ
+			multiply_address := mul_add && output.op == .get_element_ptr && output.operands[1] == producer.id
+				&& input.op == .mul && int_width(m, input.typ) == 64
+			if compare || address || multiply || multiply_address {
+				result.inputs[consumer.id] = input
+				result.skipped[producer.id] = true
+			}
+		}
+	}
+}
+
+// int_width returns zero for values that do not have an integer representation.
+pub fn int_width(m &ssa.Module, typ ssa.TypeID) int {
+	if typ <= 0 || typ >= m.type_store.types.len || m.type_store.types[typ].kind != .int_t {
+		return 0
+	}
+	return m.type_store.types[typ].width
+}
+
+fn is_int_compare(m &ssa.Module, instr ssa.Instruction) bool {
+	return instr.op in [.eq, .ne, .lt, .gt, .le, .ge, .ult, .ugt, .ule, .uge]
+		&& int_width(m, m.values[instr.operands[0]].typ) in [1, 8, 16, 32, 64]
+		&& int_width(m, m.values[instr.operands[1]].typ) in [1, 8, 16, 32, 64]
+}
+
+// shift_constant accepts a positive constant shift up to the target's limit.
+pub fn shift_constant(m &ssa.Module, id ssa.ValueID, limit int) int {
+	val := m.values[id]
+	if val.kind != .constant {
+		return 0
+	}
+	shift := val.name.parse_int(10, 32) or { return 0 }
+	return if shift > 0 && shift <= limit { int(shift) } else { 0 }
+}
+
+// has_phi reports whether an edge still requires the generator to emit phi copies.
+pub fn has_phi(m &ssa.Module, block ssa.BlockID) bool {
+	for id in m.blocks[block].instrs {
+		val := m.values[id]
+		if val.kind == .instruction {
+			return m.instrs[val.index].op == .phi
+		}
+	}
+	return false
+}
+
+// ArrayAddress describes the data and element-size fields read by native array_get.
+pub struct ArrayAddress {
+pub:
+	array       ssa.ValueID
+	index       ssa.ValueID
+	data_offset int
+	size_offset int
+}
+
+// array_address recognizes the synthetic unchecked helper, using its SSA ID.
+pub fn array_address(m &ssa.Module, instr ssa.Instruction) ?ArrayAddress {
+	if instr.op != .call || instr.operands.len != 3 || m.native_array_get == 0 {
+		return none
+	}
+	callee := m.values[instr.operands[0]]
+	if callee.kind != .func_ref || callee.index + 1 != m.native_array_get {
+		return none
+	}
+	func := m.funcs[callee.index]
+	if func.params.len != 2 {
+		return none
+	}
+	array := instr.operands[1]
+	typ := m.values[array].typ
+	if typ != m.values[func.params[0]].typ || int_width(m, m.type_store.types[typ].fields[5]) != 64 {
+		return none
+	}
+	return ArrayAddress{array, instr.operands[2], m.struct_field_offset(typ, 0), m.struct_field_offset(typ, 5)}
+}
+
+// DivisionMagic describes an exact unsigned division using a high multiply and shift.
+pub struct DivisionMagic {
+pub:
+	multiplier u64
+	shift      int
+}
+
+// division_magic computes ceil(2^(64+k)/d), where k = floor(log2(d)).
+// Use the sequence only when rounding error guarantees the result for every u64.
+pub fn division_magic(d u64) ?DivisionMagic {
+	if d < 3 || d & (d - 1) == 0 {
+		return none
+	}
+	mut shift := 0
+	for shift < 63 && d >> (shift + 1) > 0 {
+		shift++
+	}
+	mut remainder := u64(1) << shift
+	mut quotient := u64(0)
+	for _ in 0 .. 64 {
+		carry := remainder >> 63 != 0
+		remainder <<= 1
+		quotient <<= 1
+		if carry || remainder >= d {
+			remainder -= d
+			quotient |= 1
+		}
+	}
+	if d - remainder > u64(1) << shift {
+		return none
+	}
+	return DivisionMagic{quotient + 1, shift}
+}
