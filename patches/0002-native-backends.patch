diff --git a/vlib/v/gen/arm64/native_scalar.v b/vlib/v/gen/arm64/native_scalar.v
new file mode 100644
index 00000000..185b5ffd
--- /dev/null
+++ b/vlib/v/gen/arm64/native_scalar.v
@@ -0,0 +1,192 @@
+module arm64
+
+import v.gen.nativeopt
+import v.ssa
+
+fn (mut g Gen) gen_native_scalar(id ssa.ValueID, instr ssa.Instruction) bool {
+	if producer := g.selection.inputs[id] {
+		match instr.op {
+			.br {
+				lhs := g.load_val(producer.operands[0], 8)
+				rhs := g.load_val(producer.operands[1], 9)
+				g.emit32(asm_cmp_reg(Reg(lhs), Reg(rhs)))
+				g.emit_scalar_branch(instr, scalar_condition(producer.op), 0)
+			}
+			.get_element_ptr {
+				base := g.load_val(instr.operands[0], 8)
+				index := g.load_val(producer.operands[0], 9)
+				if producer.op == .mul {
+					scale := g.load_val(producer.operands[1], 10)
+					g.emit32(asm_madd(Reg(8), Reg(index), Reg(scale), Reg(base)))
+				} else {
+					shift := nativeopt.shift_constant(g.m, producer.operands[1], 3)
+					g.emit32(asm_add_reg(Reg(8), Reg(base), Reg(index)) | u32(shift << 10))
+				}
+				g.store_val(8, id)
+			}
+			.add {
+				first := g.load_val(producer.operands[0], 8)
+				second := g.load_val(producer.operands[1], 9)
+				addend_id := if instr.operands[0] in g.selection.skipped {
+					instr.operands[1]
+				} else {
+					instr.operands[0]
+				}
+				addend := g.load_val(addend_id, 10)
+				g.emit32(asm_madd(Reg(8), Reg(first), Reg(second), Reg(addend)))
+				g.store_val(8, id)
+			}
+			else { return false }
+		}
+		return true
+	}
+	if instr.op == .br && instr.operands.len == 3 {
+		reg := g.load_val(instr.operands[0], 8)
+		g.emit_scalar_branch(instr, -1, reg)
+		return true
+	}
+	if instr.op == .bitcast && instr.operands.len == 1 {
+		source := g.m.type_store.types[g.m.values[instr.operands[0]].typ]
+		result := g.m.type_store.types[instr.typ]
+		same_word := (source.kind == .ptr_t && result.kind == .ptr_t)
+			|| (source.kind == .int_t && result.kind == .int_t && source.width == 64 && result.width == 64)
+		if same_word {
+			reg := g.load_val(instr.operands[0], 8)
+			g.store_val(reg, id)
+			return true
+		}
+	}
+	if instr.op == .select && instr.operands.len == 3 && nativeopt.int_width(g.m, instr.typ) in [
+		1,
+		8,
+		16,
+		32,
+		64,
+	] {
+		cond := g.load_val(instr.operands[0], 8)
+		lhs := g.load_val(instr.operands[1], 9)
+		rhs := g.load_val(instr.operands[2], 10)
+		g.emit32(asm_cmp_imm(Reg(cond), 0))
+		// csel x8, lhs, rhs, ne
+		g.emit32(0x9a801000 | u32(rhs << 16) | u32(lhs << 5) | 8)
+		g.store_val(8, id)
+		return true
+	}
+	if address := nativeopt.array_address(g.m, instr) {
+		if off := g.stack_slot(address.array) {
+			// Read the two fields the synthetic helper uses without copying the header.
+			g.emit_load_fp(8, off + address.data_offset)
+			g.emit_load_fp(9, off + address.size_offset)
+			index := g.load_val(address.index, 10)
+			g.emit32(asm_madd(Reg(8), Reg(index), Reg(9), Reg(8)))
+			g.store_val(8, id)
+			return true
+		}
+	}
+	if instr.operands.len != 2 || instr.op !in [.add, .sub, .get_element_ptr, .udiv, .shl, .lshr] {
+		return false
+	}
+	rhs := g.m.values[instr.operands[1]]
+	if rhs.kind != .constant || rhs.name == 'undef' || nativeopt.int_width(g.m, rhs.typ) == 0 {
+		return false
+	}
+	imm := parse_arm64_int(rhs.name)
+	width := nativeopt.int_width(g.m, instr.typ)
+	if instr.op == .udiv && width == 64 {
+		magic := nativeopt.division_magic(u64(imm)) or { return false }
+		lhs := g.load_val(instr.operands[0], 8)
+		g.emit_mov_imm(9, i64(magic.multiplier))
+		g.emit32(asm_umulh(Reg(8), Reg(lhs), Reg(9)))
+		g.emit32(asm_lsr_imm(Reg(8), Reg(8), u32(magic.shift)))
+		g.store_val(8, id)
+		return true
+	}
+	if instr.op in [.shl, .lshr] && width == 64 && imm > 0 && imm < 64 {
+		lhs := g.load_val(instr.operands[0], 8)
+		if instr.op == .lshr {
+			g.emit32(asm_lsr_imm(Reg(8), Reg(lhs), u32(imm)))
+		} else {
+			g.emit32(0xd3400000 | (u32(64 - imm) << 16) | (u32(63 - imm) << 10) | u32(lhs << 5) | 8)
+		}
+		g.store_val(8, id)
+		return true
+	}
+	if instr.op !in [.add, .sub, .get_element_ptr] || imm < 0 || imm >= 4096
+		|| (width == 0 && g.m.type_store.types[instr.typ].kind != .ptr_t) {
+		return false
+	}
+	lhs := g.load_val(instr.operands[0], 8)
+	if instr.op == .sub {
+		g.emit32(asm_sub_imm(Reg(8), Reg(lhs), u32(imm)))
+	} else {
+		g.emit32(asm_add_imm(Reg(8), Reg(lhs), u32(imm)))
+	}
+	if instr.op != .get_element_ptr {
+		g.emit_wrap_to_width(8, instr.typ)
+	}
+	g.store_val(8, id)
+	return true
+}
+
+fn scalar_condition(op ssa.OpCode) int {
+	return match op {
+		.eq { 0 }
+		.ne { 1 }
+		.uge { 2 }
+		.ult { 3 }
+		.ugt { 8 }
+		.ule { 9 }
+		.ge { 10 }
+		.lt { 11 }
+		.gt { 12 }
+		.le { 13 }
+		else { -1 }
+	}
+}
+
+fn (mut g Gen) emit_scalar_branch(instr ssa.Instruction, cond int, reg int) {
+	then_block := int(instr.operands[1])
+	else_block := int(instr.operands[2])
+	if then_block == g.next_block {
+		g.emit32(if cond < 0 { asm_cbnz(Reg(reg), 2) } else { asm_b_cond(u32(cond), 2) })
+		g.emit_branch_to_block(else_block)
+	} else if else_block == g.next_block {
+		g.emit32(if cond < 0 { asm_cbz(Reg(reg), 2) } else { asm_b_cond(u32(cond ^ 1), 2) })
+		g.emit_branch_to_block(then_block)
+	} else {
+		g.emit32(if cond < 0 { asm_cbnz(Reg(reg), 2) } else { asm_b_cond(u32(cond), 2) })
+		g.emit_branch_to_block(else_block)
+		g.emit_branch_to_block(then_block)
+	}
+}
+
+// A jump to a pure loop test can perform the comparison on the backedge.
+// The taken edge is a single conditional branch to an already emitted block.
+fn (mut g Gen) emit_scalar_loop_backedge(header ssa.BlockID) bool {
+	if _ := g.block_offset(header) {
+		ids := g.m.blocks[header].instrs
+		if ids.len != 2 {
+			return false
+		}
+		cmp := g.selection.inputs[ids[1]] or { return false }
+		branch := g.m.instrs[g.m.values[ids[1]].index]
+		if branch.op != .br {
+			return false
+		}
+		body := g.block_offset(branch.operands[1]) or { return false }
+		distance := g.text_offset() - body
+		if distance < 0 || distance >= (1 << 20) - 64 {
+			return false
+		}
+		lhs := g.load_val(cmp.operands[0], 8)
+		rhs := g.load_val(cmp.operands[1], 9)
+		g.emit32(asm_cmp_reg(Reg(lhs), Reg(rhs)))
+		g.emit32(asm_b_cond(u32(scalar_condition(cmp.op)), i32((body - g.text_offset()) / 4)))
+		exit_block := branch.operands[2]
+		if exit_block != g.next_block {
+			g.emit_branch_to_block(exit_block)
+		}
+		return true
+	}
+	return false
+}
