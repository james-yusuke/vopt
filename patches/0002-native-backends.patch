@@ -0,0 +1,29 @@
+module nativeopt
+
+fn high_product(a u64, b u64) u64 {
+	mask := u64(0xffffffff)
+	a_lo, a_hi := a & mask, a >> 32
+	b_lo, b_hi := b & mask, b >> 32
+	first := a_hi * b_lo + ((a_lo * b_lo) >> 32)
+	second := a_lo * b_hi + (first & mask)
+	return a_hi * b_hi + (first >> 32) + (second >> 32)
+}
+
+fn test_division_magic_matches_unsigned_division() {
+	mut state := u64(0x1c17077a9812bb1c)
+	for d in [u64(3), 5, 7, 10, 31, 63, 1000, 0x8000000000000001, max_u64] {
+		magic := division_magic(d) or { continue }
+		for n in [u64(0), 1, d - 1, d, max_u64 - 1, max_u64] {
+			assert high_product(n, magic.multiplier) >> magic.shift == n / d
+		}
+		for _ in 0 .. 1000 {
+			state ^= state << 13
+			state ^= state >> 7
+			state ^= state << 17
+			assert high_product(state, magic.multiplier) >> magic.shift == state / d
+		}
+	}
+	assert division_magic(10) != none
+	assert division_magic(0) == none
+	assert division_magic(32) == none
+}
