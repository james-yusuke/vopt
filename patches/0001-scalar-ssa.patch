diff --git a/vlib/v/ssa/optimize/native_array.v b/vlib/v/ssa/optimize/native_array.v
new file mode 100644
index 00000000..f10c1310
--- /dev/null
+++ b/vlib/v/ssa/optimize/native_array.v
@@ -0,0 +1,70 @@
+module optimize
+
+import v.ssa
+
+// An aggregate load used only by synthetic array_get can load just the two
+// fields needed for address calculation. Keep the reads at the snapshot, even
+// when the helper is used after code that could modify the original array.
+fn lower_native_array_snapshots(mut m ssa.Module) {
+	if m.native_array_get == 0 {
+		return
+	}
+	get := m.funcs[m.native_array_get - 1]
+	if get.params.len != 2 {
+		return
+	}
+	array_type := m.values[get.params[0]].typ
+	fields := m.type_store.types[array_type].fields
+	if fields.len != 6 || m.type_store.types[fields[5]].width != 64 {
+		return
+	}
+	word := m.type_store.get_int(64)
+	data_ptr := m.type_store.get_ptr(fields[0])
+	size_ptr := m.type_store.get_ptr(fields[5])
+	data_offset := m.get_or_add_const(word, '${m.struct_field_offset(array_type, 0)}')
+	size_offset := m.get_or_add_const(word, '${m.struct_field_offset(array_type, 5)}')
+	for id in 1 .. m.values.len {
+		v := m.values[id]
+		if v.kind != .instruction || v.typ != array_type || v.uses.len != 1 {
+			continue
+		}
+		snapshot := m.instrs[v.index]
+		if snapshot.op != .load || snapshot.operands.len != 1 || snapshot.atomic_ord != .not_atomic {
+			continue
+		}
+		call_id := v.uses[0]
+		call := m.instrs[m.values[call_id].index]
+		if call.op != .call || call.operands.len != 3 || call.operands[1] != id {
+			continue
+		}
+		callee := m.values[call.operands[0]]
+		if callee.kind != .func_ref || callee.index + 1 != m.native_array_get {
+			continue
+		}
+		base := snapshot.operands[0]
+		data_address := insert_native_instr_before(mut m, id, .get_element_ptr, data_ptr, [
+			base,
+			data_offset,
+		])
+		data := insert_native_instr_before(mut m, id, .load, fields[0], [data_address])
+		size_address := insert_native_instr_before(mut m, id, .get_element_ptr, size_ptr, [
+			base,
+			size_offset,
+		])
+		size := insert_native_instr_before(mut m, id, .load, fields[5], [size_address])
+		byte_offset := insert_native_instr_before(mut m, call_id, .mul, word, [
+			call.operands[2],
+			size,
+		])
+		m.rewrite_instruction(call_id, .get_element_ptr, [data, byte_offset])
+	}
+}
+
+fn insert_native_instr_before(mut m ssa.Module, anchor ssa.ValueID, op ssa.OpCode, typ ssa.TypeID, operands []ssa.ValueID) ssa.ValueID {
+	block := m.instrs[m.values[anchor].index].block
+	position := m.blocks[block].instrs.index(anchor)
+	id := m.add_instr(op, block, typ, operands)
+	m.blocks[block].instrs.delete_last()
+	m.blocks[block].instrs.insert(position, id)
+	return id
+}
diff --git a/vlib/v/ssa/optimize/native_diamond.v b/vlib/v/ssa/optimize/native_diamond.v
new file mode 100644
index 00000000..7209bb91
--- /dev/null
+++ b/vlib/v/ssa/optimize/native_diamond.v
@@ -0,0 +1,83 @@
+module optimize
+
+import v.ssa
+
+fn native_diamond_arm(m &ssa.Module, block ssa.BlockID, from ssa.BlockID) ?ssa.BlockID {
+	b := m.blocks[block]
+	if b.preds != [from] || b.succs.len != 1 || b.instrs.len == 0 || b.instrs.len > 5 {
+		return none
+	}
+	for id in b.instrs[..b.instrs.len - 1] {
+		val := m.values[id]
+		if val.kind != .instruction || m.type_store.types[val.typ].kind != .int_t
+			|| m.instrs[val.index].op !in [.add, .sub, .and_, .or_, .xor, .bitcast, .sext, .zext,
+				.trunc] {
+			return none
+		}
+	}
+	last := m.values[b.instrs.last()]
+	if last.kind != .instruction || m.instrs[last.index].op != .jmp {
+		return none
+	}
+	return b.succs[0]
+}
+
+// A small pure diamond with one integer phi can be lowered to a conditional move.
+fn convert_native_diamonds(mut m ssa.Module) bool {
+	mut changed := false
+	for func in m.funcs {
+		for block in func.blocks {
+			if m.blocks[block].succs.len != 2 || m.blocks[block].instrs.len == 0 {
+				continue
+			}
+			term_id := m.blocks[block].instrs.last()
+			term := m.instrs[m.values[term_id].index]
+			if term.op != .br || term.operands.len != 3 {
+				continue
+			}
+			then_id, else_id := term.operands[1], term.operands[2]
+			join := native_diamond_arm(m, then_id, block) or { continue }
+			other_join := native_diamond_arm(m, else_id, block) or { continue }
+			if join != other_join || join in [block, then_id, else_id] || m.blocks[join].preds.len != 2 {
+				continue
+			}
+			mut phi_id := ssa.ValueID(0)
+			for id in m.blocks[join].instrs {
+				val := m.values[id]
+				if val.kind == .instruction && m.instrs[val.index].op == .phi {
+					if phi_id != 0 {
+						phi_id = 0
+						break
+					}
+					phi_id = id
+				}
+			}
+			if phi_id == 0 {
+				continue
+			}
+			phi := m.instrs[m.values[phi_id].index]
+			if m.type_store.types[phi.typ].kind != .int_t || phi.operands.len != 4 {
+				continue
+			}
+			first := if phi.operands[1] == then_id { 0 } else { 2 }
+			m.blocks[block].instrs.delete_last()
+			for arm in [then_id, else_id] {
+				ids := m.blocks[arm].instrs
+				for id in ids[..ids.len - 1] {
+					m.instrs[m.values[id].index].block = block
+					m.blocks[block].instrs << id
+				}
+				m.blocks[arm].instrs = [ids.last()]
+			}
+			selected := m.add_instr(.select, block, phi.typ, [term.operands[0], phi.operands[first],
+				phi.operands[2 - first]])
+			m.replace_uses(phi_id, selected)
+			m.detach_instruction_uses(phi_id)
+			m.blocks[join].instrs.delete(m.blocks[join].instrs.index(phi_id))
+			m.blocks[block].instrs << term_id
+			m.rewrite_instruction(term_id, .jmp, [join])
+			changed = true
+		}
+	}
+	return changed
+}
diff --git a/vlib/v/ssa/optimize/native_scalar.v b/vlib/v/ssa/optimize/native_scalar.v
new file mode 100644
index 00000000..fe110dba
--- /dev/null
+++ b/vlib/v/ssa/optimize/native_scalar.v
@@ -0,0 +1,409 @@
+module optimize
+
+import v.ssa
+
+fn optimize_native_scalar(mut m ssa.Module) {
+	lower_native_array_snapshots(mut m)
+	fold_native_integer_casts(mut m)
+	// Folding a branch exposes more constants through the surviving phi inputs.
+	// Limit rounds so nested constant branches cannot dominate compilation time.
+	mut cfg_changed := false
+	for _ in 0 .. 4 {
+		constant_fold(mut m)
+		if !branch_fold(mut m) {
+			break
+		}
+		cfg_changed = true
+		build_cfg(mut m)
+		remove_unreachable_blocks(mut m)
+		build_cfg(mut m)
+		prune_phi_operands(mut m)
+		simplify_phi_nodes(mut m)
+	}
+	if convert_native_diamonds(mut m) {
+		cfg_changed = true
+		build_cfg(mut m)
+		remove_unreachable_blocks(mut m)
+		build_cfg(mut m)
+		prune_phi_operands(mut m)
+	}
+	if cfg_changed {
+		cfg := cfg_data_from_module(m)
+		compute_dominators(mut m, &cfg)
+	}
+	for func in m.funcs {
+		for header in func.blocks {
+			loop := find_native_loop(m, func, header) or { continue }
+			hoist_native_invariants(mut m, func, loop)
+			reduce_native_induction(mut m, func, loop)
+		}
+	}
+	common_subexpression_elimination(mut m)
+	remove_native_dead_cycles(mut m)
+}
+
+// SSA use counts alone cannot remove an unused loop-carried phi cycle.
+fn remove_native_dead_cycles(mut m ssa.Module) {
+	mut live := []bool{len: m.values.len}
+	mut work := []ssa.ValueID{}
+	for func in m.funcs {
+		for block in func.blocks {
+			for id in m.blocks[block].instrs {
+				value := m.values[id]
+				if value.kind == .instruction && instruction_has_side_effects(m.instrs[value.index].op) {
+					live[id] = true
+					work << id
+				}
+			}
+		}
+	}
+	for work.len > 0 {
+		instr := m.instrs[m.values[work.pop()].index]
+		for oi, id in instr.operands {
+			if instr.is_value_operand(oi) && !live[id] && m.values[id].kind == .instruction {
+				live[id] = true
+				work << id
+			}
+		}
+	}
+	for func in m.funcs {
+		for block in func.blocks {
+			mut kept := []ssa.ValueID{cap: m.blocks[block].instrs.len}
+			for id in m.blocks[block].instrs {
+				if m.values[id].kind != .instruction || live[id] {
+					kept << id
+				} else {
+					m.detach_instruction_uses(id)
+				}
+			}
+			m.blocks[block].instrs = kept
+		}
+	}
+}
+
+struct NativeLoop {
+	header    ssa.BlockID
+	latch     ssa.BlockID
+	preheader ssa.BlockID
+	body      map[ssa.BlockID]bool
+}
+
+fn find_native_loop(m &ssa.Module, func ssa.Function, header ssa.BlockID) ?NativeLoop {
+	preds := m.blocks[header].preds
+	if preds.len != 2 {
+		return none
+	}
+	mut preheader := preds[0]
+	mut latch := preds[1]
+	if dominates(m, func, header, preheader) {
+		preheader, latch = latch, preheader
+	}
+	if dominates(m, func, header, preheader) || !dominates(m, func, header, latch)
+		|| m.blocks[preheader].succs.len != 1 || m.blocks[preheader].instrs.len == 0 {
+		return none
+	}
+	mut body := {
+		header: true
+	}
+	mut pending := [latch]
+	for pending.len > 0 {
+		block := pending.pop()
+		if block in body {
+			continue
+		}
+		if body.len >= 128 || !dominates(m, func, header, block) {
+			return none
+		}
+		body[block] = true
+		pending << m.blocks[block].preds
+	}
+	return NativeLoop{header, latch, preheader, body}
+}
+
+fn is_native_invariant(m &ssa.Module, func ssa.Function, loop NativeLoop, id ssa.ValueID) bool {
+	value := m.values[id]
+	if value.kind == .argument || (value.kind == .constant && value.name != 'undef') {
+		return true
+	}
+	if value.kind != .instruction {
+		return false
+	}
+	block := m.instrs[value.index].block
+	return block !in loop.body && dominates(m, func, block, loop.preheader)
+}
+
+fn hoist_native_invariants(mut m ssa.Module, func ssa.Function, loop NativeLoop) {
+	// Only speculate operations that can safely run when the loop body is skipped.
+	for block in func.blocks {
+		if block !in loop.body {
+			continue
+		}
+		mut kept := []ssa.ValueID{cap: m.blocks[block].instrs.len}
+		for id in m.blocks[block].instrs {
+			value := m.values[id]
+			if value.kind != .instruction || value.uses.len == 0 {
+				kept << id
+				continue
+			}
+			instr := m.instrs[value.index]
+			integer := m.type_store.types[value.typ].kind == .int_t
+			speculatable := instr.op == .get_element_ptr
+				|| (integer && instr.op in [.add, .sub, .mul, .and_, .or_, .xor, .zext, .sext,
+					.trunc])
+				|| (instr.op == .load && native_immutable_load(m, func, loop, instr))
+			if !speculatable
+				|| !instr.operands.all(is_native_invariant(m, func, loop, it)) {
+				kept << id
+				continue
+			}
+			m.instrs[value.index].block = loop.preheader
+			m.blocks[loop.preheader].instrs.insert(m.blocks[loop.preheader].instrs.len - 1, id)
+		}
+		m.blocks[block].instrs = kept
+	}
+}
+
+fn fold_native_integer_casts(mut m ssa.Module) {
+	for func in m.funcs {
+		for block in func.blocks {
+			for id in m.blocks[block].instrs {
+				value := m.values[id]
+				if value.kind != .instruction || value.uses.len == 0 {
+					continue
+				}
+				instr := m.instrs[value.index]
+				if instr.op !in [.bitcast, .zext, .trunc] || instr.operands.len != 1 {
+					continue
+				}
+				from := m.type_store.types[m.values[instr.operands[0]].typ]
+				to := m.type_store.types[value.typ]
+				if from.kind != .int_t || to.kind != .int_t || from.width < 1 || from.width > 64
+					|| to.width < 1 || to.width > 64 || (instr.op == .bitcast && from.width != to.width) {
+					continue
+				}
+				constant := native_constant(m, instr.operands[0]) or { continue }
+				mut bits := u64(constant)
+				if instr.op == .zext && from.width < 64 {
+					bits &= (u64(1) << from.width) - 1
+				}
+				if to.width < 64 {
+					mask := (u64(1) << to.width) - 1
+					bits &= mask
+					if !to.is_unsigned && to.width > 1 && bits & (u64(1) << (to.width - 1)) != 0 {
+						bits |= ~mask
+					}
+				}
+				replacement := m.get_or_add_const(value.typ, '${i64(bits)}')
+				m.replace_uses(id, replacement)
+			}
+		}
+	}
+}
+
+// A load from a local aggregate can run in the preheader when the aggregate
+// has one dominating full initialization and its address does not escape.
+fn native_immutable_load(m &ssa.Module, func ssa.Function, loop NativeLoop, load ssa.Instruction) bool {
+	if load.atomic_ord != .not_atomic || load.operands.len != 1 {
+		return false
+	}
+	address := m.values[load.operands[0]]
+	if address.kind != .instruction {
+		return false
+	}
+	field := m.instrs[address.index]
+	if field.op != .get_element_ptr || field.operands.len != 2 {
+		return false
+	}
+	offset := native_constant(m, field.operands[1]) or { return false }
+	root := m.values[field.operands[0]]
+	if offset < 0 || root.kind != .instruction || m.instrs[root.index].op != .alloca {
+		return false
+	}
+	element := m.type_store.types[root.typ].elem_type
+	size := m.type_size(load.typ)
+	if size <= 0 || offset > m.type_size(element) - size {
+		return false
+	}
+	mut initialized := false
+	for user in root.uses {
+		instr := m.instrs[m.values[user].index]
+		match instr.op {
+			.load {
+				if instr.atomic_ord != .not_atomic {
+					return false
+				}
+			}
+			.store {
+				if initialized || instr.atomic_ord != .not_atomic || instr.operands[1] != root.id
+					|| m.values[instr.operands[0]].typ != element || instr.block in loop.body
+					|| !dominates(m, func, instr.block, loop.preheader) {
+					return false
+				}
+				initialized = true
+			}
+			.get_element_ptr {
+				if instr.operands[0] != root.id {
+					return false
+				}
+				for field_user in m.values[user].uses {
+					access := m.instrs[m.values[field_user].index]
+					if access.op != .load || access.atomic_ord != .not_atomic {
+						return false
+					}
+				}
+			}
+			else { return false }
+		}
+	}
+	return initialized
+}
+
+fn native_constant(m &ssa.Module, id ssa.ValueID) ?i64 {
+	value := m.values[id]
+	if value.kind != .constant {
+		return none
+	}
+	return integer_constant_value(m, value)
+}
+
+fn native_induction_scale(m &ssa.Module, instr ssa.Instruction, induction ssa.ValueID, width int) ?i64 {
+	if instr.operands.len != 2 {
+		return none
+	}
+	if instr.op == .mul {
+		other := if instr.operands[0] == induction {
+			instr.operands[1]
+		} else if instr.operands[1] == induction {
+			instr.operands[0]
+		} else {
+			return none
+		}
+		return native_constant(m, other)
+	}
+	if instr.op == .shl && instr.operands[0] == induction {
+		shift := native_constant(m, instr.operands[1])?
+		if shift >= 4 && shift < width {
+			return i64(u64(1) << shift)
+		}
+	}
+	return none
+}
+
+fn insert_before_native_terminator(mut m ssa.Module, op ssa.OpCode, block ssa.BlockID, typ ssa.TypeID, operands []ssa.ValueID) ssa.ValueID {
+	id := m.add_instr(op, block, typ, operands)
+	m.blocks[block].instrs.delete_last()
+	m.blocks[block].instrs.insert(m.blocks[block].instrs.len - 1, id)
+	return id
+}
+
+fn reduce_native_induction(mut m ssa.Module, func ssa.Function, loop NativeLoop) {
+	if m.blocks[loop.latch].instrs.len == 0 {
+		return
+	}
+	mut budget := 2
+	for induction in m.blocks[loop.header].instrs.clone() {
+		value := m.values[induction]
+		if value.kind != .instruction || value.typ <= 0 {
+			continue
+		}
+		phi := m.instrs[value.index]
+		typ := m.type_store.types[value.typ]
+		if phi.op != .phi || phi.operands.len != 4 || typ.kind != .int_t || typ.width !in [
+			32,
+			64,
+		] {
+			continue
+		}
+		entry_index := if phi.operands[1] == loop.preheader { 0 } else { 2 }
+		start := phi.operands[entry_index]
+		back := m.values[phi.operands[2 - entry_index]]
+		if back.kind != .instruction || back.typ != value.typ {
+			continue
+		}
+		update := m.instrs[back.index]
+		if update.op != .add || update.block != loop.latch || update.operands.len != 2
+			|| update.operands[0] != induction {
+			continue
+		}
+		step := native_constant(m, update.operands[1]) or { continue }
+		mut scaled := map[i64]ssa.ValueID{}
+		for user in m.values[induction].uses.clone() {
+			candidate := m.values[user]
+			if candidate.kind != .instruction || candidate.typ != value.typ || candidate.uses.len == 0 {
+				continue
+			}
+			instr := m.instrs[candidate.index]
+			if instr.block !in loop.body {
+				continue
+			}
+			// For strided loops a second recurrence can cost more than reusing the scaled index.
+			if budget > 0 && step == 1 && typ.width == 64 && instr.op == .mul && instr.operands.len == 2 {
+				factor := if instr.operands[0] == induction {
+					instr.operands[1]
+				} else {
+					instr.operands[0]
+				}
+				if m.values[factor].kind != .constant && is_native_invariant(m, func, loop, factor)
+					&& reduce_native_pointer_induction(mut m, func, loop, candidate, start,
+						update.operands[1], factor) {
+					budget--
+					continue
+				}
+			}
+			scale := native_induction_scale(m, instr, induction, typ.width) or { continue }
+			if scale in [0, 1, 2, 4, 8] {
+				continue
+			}
+			if replacement := scaled[scale] {
+				m.replace_uses(user, replacement)
+				continue
+			}
+			if budget == 0 {
+				continue
+			}
+			budget--
+			factor := m.get_or_add_const(value.typ, '${scale}')
+			initial := insert_before_native_terminator(mut m, .mul, loop.preheader, value.typ,
+				[start, factor])
+			new_phi := m.add_instr_front(.phi, loop.header, value.typ, [initial, loop.preheader])
+			// Both the original computation and the recurrence wrap at the SSA width.
+			delta := m.get_or_add_const(value.typ, '${i64(u64(step) * u64(scale))}')
+			next := insert_before_native_terminator(mut m, .add, loop.latch, value.typ, [
+				new_phi,
+				delta,
+			])
+			m.append_phi_operands(new_phi, next, loop.latch)
+			m.replace_uses(user, new_phi)
+			scaled[scale] = new_phi
+		}
+	}
+}
+
+fn reduce_native_pointer_induction(mut m ssa.Module, func ssa.Function, loop NativeLoop, offset ssa.Value, start ssa.ValueID, step ssa.ValueID, scale ssa.ValueID) bool {
+	if offset.uses.len != 1 {
+		return false
+	}
+	address := m.values[offset.uses[0]]
+	if address.kind != .instruction || address.uses.len == 0 {
+		return false
+	}
+	gep := m.instrs[address.index]
+	if gep.op != .get_element_ptr || gep.operands.len != 2 || gep.operands[1] != offset.id
+		|| gep.block !in loop.body || !is_native_invariant(m, func, loop, gep.operands[0]) {
+		return false
+	}
+	initial_offset := insert_before_native_terminator(mut m, .mul, loop.preheader, offset.typ,
+		[start, scale])
+	initial := insert_before_native_terminator(mut m, .get_element_ptr, loop.preheader, address.typ,
+		[gep.operands[0], initial_offset])
+	delta := insert_before_native_terminator(mut m, .mul, loop.preheader, offset.typ, [
+		step,
+		scale,
+	])
+	pointer := m.add_instr_front(.phi, loop.header, address.typ, [initial, loop.preheader])
+	next := insert_before_native_terminator(mut m, .get_element_ptr, loop.latch, address.typ,
+		[pointer, delta])
+	m.append_phi_operands(pointer, next, loop.latch)
+	m.replace_uses(address.id, pointer)
+	return true
+}
diff --git a/vlib/v/ssa/optimize/native_scalar_test.v b/vlib/v/ssa/optimize/native_scalar_test.v
new file mode 100644
index 00000000..1aaa4ef1
--- /dev/null
+++ b/vlib/v/ssa/optimize/native_scalar_test.v
@@ -0,0 +1,34 @@
+module optimize
+
+import v.ssa
+
+fn test_native_scalar_folds_branch_after_mem2reg() {
+	mut m := ssa.Module.new()
+	word := m.type_store.get_uint(64)
+	ptr := m.type_store.get_ptr(word)
+	bit := m.type_store.get_int(1)
+	func := m.new_function('fold_branch', word)
+	entry := m.add_block(func, 'entry')
+	left := m.add_block(func, 'left')
+	right := m.add_block(func, 'right')
+	result := m.add_block(func, 'result')
+	one := m.get_or_add_const(word, '1')
+	two := m.get_or_add_const(word, '2')
+	addr := m.add_instr(.alloca, entry, ptr, [])
+	m.add_instr(.store, entry, 0, [one, addr])
+	load := m.add_instr(.load, entry, word, [addr])
+	cond := m.add_instr(.eq, entry, bit, [load, one])
+	m.add_instr(.br, entry, 0, [cond, left, right])
+	m.add_instr(.jmp, left, 0, [result])
+	m.add_instr(.jmp, right, 0, [result])
+	phi := m.add_instr(.phi, result, word, [one, left, two, right])
+	ret := m.add_instr(.ret, result, 0, [phi])
+	optimize_with_options(mut m, OptimizeOptions{
+		mem2reg:        true
+		native_scalar:  true
+		eliminate_phis: true
+		strict_verify:  true
+	})
+	assert right !in m.funcs[func].blocks
+	assert m.instrs[m.values[ret].index].operands == [one]
+}
